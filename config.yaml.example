devices:
  - name: "Core Switch"
    host: "192.168.1.1"
    ports: [22, 80, 443]
  - name: "ESXi Host"
    host: "192.168.1.10"
    ports: [22, 443, 902]
  - name: "Gateway"
    host: "192.168.1.254"
    ports: [22, 80]

thresholds:
  ping_timeout: 3
  port_timeout: 2
  max_response_time: 100

alerts:
  email:
    enabled: false
    smtp_server: ""
    smtp_port: 587
    username: ""
    password: ""
    recipients: []
  webhook:
    enabled: false
    url: ""
  telegram:
    enabled: false
    bot_token: ""     # from @BotFather
    chat_id: ""       # your chat id (get via @userinfobot)
  console:
    enabled: true

logging:
  level: "INFO"
  file: "monitor.log"
  max_size_mb: 5
  backup_count: 3

dashboard:
  host: "0.0.0.0"
  port: 5000
  refresh_seconds: 30
