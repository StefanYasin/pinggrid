# PingGrid configuration.
#
# You normally don't need this file: on first run PingGrid detects your
# network (gateway, local IP, subnet sweep) and auto-creates config.yaml.
# This file documents every option if you want to configure things by hand.
# Copy to config.yaml and edit, or run: python monitor.py --reset-config

devices:
  - name: "This Machine"
    host: "192.168.2.100"
    ports: []
  - name: "Gateway"
    host: "192.168.2.1"
    ports: [80, 443]

monitor:
  interval_seconds: 30        # seconds between check cycles

thresholds:
  ping_timeout: 3             # seconds per ping
  port_timeout: 2             # seconds per port connect
  max_response_time: 100      # ms before latency warning

alerting:
  repeat_interval_minutes: 15 # re-alert while a device stays down

alerts:
  email:
    enabled: false
    smtp_server: ""
    smtp_port: 587
    username: ""
    password: ""
    recipients: []
  webhook:
    enabled: false
    url: ""
  telegram:
    enabled: false
    bot_token: ""     # from @BotFather
    chat_id: ""       # your chat id (get via @userinfobot)
  console:
    enabled: true

logging:
  level: "INFO"
  file: "monitor.log"
  max_size_mb: 5
  backup_count: 3

dashboard:
  host: "0.0.0.0"
  port: 5000
  refresh_seconds: 30
